{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss-in-app.github.io/palsal/contract/content.schema.json",
  "title": "palsal 정적 콘텐츠 v1 (GitHub Pages)",
  "description": "세 파일: symbols.json(종목 검색 목록) · universe.json(시총 상위 목록, 손으로 월 1회) · content.json(도움말·용어 시트·면책·출처·공지). 모두 완성된 문자열만, URL·표현식·템플릿 없음. contentVersion 은 늘리기만, minClientVersion 보다 낮은 앱은 원격을 버리고 번들 동봉본을 쓴다.",
  "oneOf": [
    { "$ref": "#/$defs/symbolsFile" },
    { "$ref": "#/$defs/universeFile" },
    { "$ref": "#/$defs/contentFile" }
  ],
  "$defs": {
    "version": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "symbol": { "type": "string", "pattern": "^[\\^]?[A-Z0-9.=\\-]{1,20}$" },
    "line": { "type": "string", "minLength": 1, "maxLength": 80 },
    "body": { "type": "string", "minLength": 1, "maxLength": 600 },
    "termKey": { "type": "string", "pattern": "^[a-z0-9-]{2,30}$" },
    "symbolsFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema", "contentVersion", "minClientVersion", "items"],
      "properties": {
        "kind": { "const": "symbols" },
        "schema": { "const": 1 },
        "contentVersion": { "$ref": "#/$defs/version" },
        "minClientVersion": { "$ref": "#/$defs/semver" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["s", "n", "m"],
            "properties": {
              "s": { "$ref": "#/$defs/symbol" },
              "n": { "type": "string", "minLength": 1, "maxLength": 40, "description": "화면 이름(한국어). 국내 종목은 상장 이름, 해외는 새로 지은 한글 이름 또는 영문" },
              "e": { "type": "string", "maxLength": 80, "description": "영문 이름" },
              "a": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 20 }, "description": "검색 별칭(새로 만든 것만, 원본 표 사용 금지)" },
              "m": { "enum": ["KR", "US", "CRYPTO", "FX"] },
              "x": { "enum": ["KOSPI", "KOSDAQ", "NASDAQ", "NYSE", "NYSEARCA", "AMEX", "BINANCE", "FX"] }
            }
          }
        }
      }
    },
    "universeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema", "contentVersion", "asOfDate", "kr", "us"],
      "properties": {
        "kind": { "const": "universe" },
        "schema": { "const": 1 },
        "contentVersion": { "$ref": "#/$defs/version" },
        "asOfDate": { "$ref": "#/$defs/date", "description": "시가총액 순위 기준일" },
        "kr": { "type": "array", "minItems": 15, "maxItems": 30, "uniqueItems": true, "items": { "$ref": "#/$defs/symbol" } },
        "us": { "type": "array", "minItems": 15, "maxItems": 30, "uniqueItems": true, "items": { "$ref": "#/$defs/symbol" } }
      }
    },
    "contentFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "schema", "contentVersion", "minClientVersion", "notice", "zones", "howToRead", "fearGreed", "faq", "glossary", "sources", "disclaimer"],
      "properties": {
        "kind": { "const": "content" },
        "schema": { "const": 1 },
        "contentVersion": { "$ref": "#/$defs/version" },
        "minClientVersion": { "$ref": "#/$defs/semver" },
        "notice": {
          "description": "내 종목 맨 위 한 줄 공지(없으면 null)",
          "oneOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["text", "until"], "properties": { "text": { "$ref": "#/$defs/line" }, "until": { "$ref": "#/$defs/date" } } }
          ]
        },
        "zones": {
          "description": "RSI 구간 설명 4개 — 경계값은 번들 고정(<20 · ≤30 · <70 · ≥70), 여기선 글만",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "range", "name", "body"],
            "properties": {
              "key": { "enum": ["vlow", "low", "mid", "high"] },
              "range": { "type": "string", "maxLength": 12 },
              "name": { "enum": ["아주 낮음", "낮음", "보통", "높음"] },
              "body": { "$ref": "#/$defs/body" }
            }
          }
        },
        "howToRead": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "type": "object", "additionalProperties": false, "required": ["title", "body"], "properties": { "title": { "$ref": "#/$defs/line" }, "body": { "$ref": "#/$defs/body" } } }
        },
        "fearGreed": { "type": "object", "additionalProperties": false, "required": ["title", "body"], "properties": { "title": { "$ref": "#/$defs/line" }, "body": { "$ref": "#/$defs/body" } } },
        "faq": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "object", "additionalProperties": false, "required": ["q", "a"], "properties": { "q": { "$ref": "#/$defs/line" }, "a": { "$ref": "#/$defs/body" } } }
        },
        "glossary": {
          "description": "누른 말 하나만 보여 주는 시트. related 는 같은 파일 안의 키만",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/termKey" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "body", "related"],
            "properties": {
              "title": { "$ref": "#/$defs/line" },
              "body": { "$ref": "#/$defs/body" },
              "caution": { "type": "string", "maxLength": 200 },
              "related": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/termKey" } }
            }
          }
        },
        "sources": {
          "description": "설정 > 시세 출처. 글자만(링크 없음)",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "object", "additionalProperties": false, "required": ["what", "name"], "properties": { "what": { "type": "string", "maxLength": 20 }, "name": { "type": "string", "maxLength": 40 } } }
        },
        "disclaimer": { "$ref": "#/$defs/body" }
      }
    }
  }
}
