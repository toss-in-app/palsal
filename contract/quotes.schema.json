{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toss-in-app.github.io/palsal/contract/quotes.schema.json",
  "title": "palsal 현재가 v1 (GET /rest/v1/palsal_quotes)",
  "description": "PostgREST 가 돌려주는 palsal_quotes 행 배열. 서버가 5분마다(장이 열린 시장만) 갱신. 휴대폰은 fetched_at 이 장중 20분보다 오래되면 '갱신이 늦어지고 있어요'.",
  "type": "array",
  "maxItems": 100,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "symbol",
      "price",
      "prev_close",
      "change_pct",
      "market_state",
      "ext_session",
      "ext_price",
      "ext_change_pct",
      "source",
      "fetched_at",
      "market_time"
    ],
    "properties": {
      "symbol": {
        "type": "string",
        "pattern": "^[\\^]?[A-Z0-9.=\\-]{1,20}$"
      },
      "price": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "prev_close": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "change_pct": {
        "type": "number",
        "minimum": -100,
        "maximum": 1000
      },
      "market_state": {
        "enum": [
          "PRE",
          "REGULAR",
          "POST",
          "CLOSED",
          "24H"
        ]
      },
      "ext_session": {
        "enum": [
          null,
          "pre",
          "post"
        ],
        "description": "미국 주식 프리·애프터 값이 있을 때"
      },
      "ext_price": {
        "type": [
          "number",
          "null"
        ],
        "exclusiveMinimum": 0
      },
      "ext_change_pct": {
        "type": [
          "number",
          "null"
        ]
      },
      "source": {
        "enum": [
          "yahoo",
          "binance",
          "frankfurter"
        ]
      },
      "fetched_at": {
        "type": "string",
        "format": "date-time"
      },
      "market_time": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time",
        "description": "원천의 마지막 체결 시각(프리·애프터 값이 있으면 그 시각). 한국 주식·지수는 야후가 약 20분 늦게 줘서 fetched_at 보다 20분쯤 이르다. 화면 '기준' 시각(v1.13)"
      }
    }
  }
}
